[*.cs]
# Console app: no synchronization context; ConfigureAwait is noise.
dotnet_diagnostic.CA2007.severity = none
# Poll loops intentionally catch broad exceptions to stay alive across network/IO hiccups.
dotnet_diagnostic.CA1031.severity = none
# BotApi is disposed only after Task.WhenAll(inbound, outbound) completes; the analyzer
# does not track completion through WhenAll.
dotnet_diagnostic.CA2025.severity = none
# Bot API DTO records are materialized by the JSON deserializer, never new'd directly.
dotnet_diagnostic.CA1812.severity = none
